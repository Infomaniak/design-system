name: On Figma event

on:
  workflow_dispatch:
    inputs:
      event:
        description: 'Figma WebhookV2 Event'
        required: true
        type: string

jobs:
  on-figma-event:
    name: On Figma event
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read

    steps:
      - name: Parse and validate event
        id: parse
        env:
          INPUT_EVENT: ${{ inputs.event }}
          EXPECTED_PASSCODE: ${{ secrets.FIGMA_WEBHOOK_PASSCODE }}
        run: |
          # Validate JSON structure
          if ! jq empty <<< "$INPUT_EVENT" 2>/dev/null; then
            echo "::error::Invalid JSON input"
            exit 1
          fi

          # Extract and mask passcode
          PASSCODE=$(jq -r '.passcode // empty' <<< "$INPUT_EVENT")

          # Mask immediately
          echo "::add-mask::$PASSCODE"

          # Validate passcode
          if [ -z "$PASSCODE" ] || [ "$PASSCODE" != "$EXPECTED_PASSCODE" ]; then
            echo "::error::Invalid or missing passcode"
            exit 1
          fi

          # Remove passcode from event before storing in env
          CLEAN_EVENT=$(jq -c 'del(.passcode)' <<< "$INPUT_EVENT")

          # Validate the cleaned event is valid JSON
          if [ -z "$CLEAN_EVENT" ] || ! jq empty <<< "$CLEAN_EVENT" 2>/dev/null; then
            echo "::error::Failed to process event"
            exit 1
          fi

          # Store in special GitHub Actions environment file (handles newlines safely)
          {
            echo "FIGMA_WEBHOOK_EVENT<<EOF"
            echo "$CLEAN_EVENT"
            echo "EOF"
          } >> "$GITHUB_ENV"

      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Enable Corepack
        run: corepack enable

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24'
          registry-url: 'https://registry.npmjs.org'
          always-auth: true
          cache: 'yarn'

      - name: Install dependencies
        run: yarn install --immutable

      - name: Run ci:figma-event
        run: yarn ci:figma-event
        env:
          CI_PULL_REQUEST_AUTH_TOKEN_DESIGN_SYSTEM: ${{ secrets.CI_PULL_REQUEST_AUTH_TOKEN_DESIGN_SYSTEM }}
          FIGMA_API_TOKEN: ${{ secrets.FIGMA_API_TOKEN }}
          FIGMA_ICON_FILE_KEY: ${{ secrets.FIGMA_ICON_FILE_KEY }}
          KCHAT_WEBHOOK_ID: ${{ secrets.KCHAT_WEBHOOK_ID }}
