{
  "name": "@infomaniak/design-system",
  "version": "0.0.0",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "=== DEV ===": "",
    "dev:docs": "yarn workspace @infomaniak-design-system/docs dev",
    "=== BUILD ===": "",
    "build": "yarn workspaces foreach -Apt run build",
    "build:tokens": "yarn workspace @infomaniak-design-system/tokens build",
    "build:components": "yarn workspace @infomaniak-design-system/components build",
    "build:fonts": "yarn workspace @infomaniak-design-system/fonts build",
    "build:docs": "yarn workspace @infomaniak-design-system/docs build",
    "=== CODE QUALITY ===": "",
    "format": "yarn format:fix",
    "format:check": "prettier --check --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md,mdx}\"",
    "format:fix": "prettier --write --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md,mdx}\"",
    "format:fix:tokens": "prettier --write --ignore-unknown --config .prettierrc \"./packages/tokens/tokens/**/*.json\"",
    "lint": "yarn lint:fix",
    "lint:check": "yarn lint:check:eslint && yarn lint:check:stylelint",
    "lint:fix": "yarn lint:fix:eslint && yarn lint:fix:stylelint",
    "lint:check:eslint": "yarn eslint",
    "lint:fix:eslint": "yarn eslint --fix",
    "lint:check:stylelint": "stylelint \"**/*.css\"",
    "lint:fix:stylelint": "stylelint \"**/*.css\" --fix",
    "check": "yarn check:types && yarn format:check && yarn lint:check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "=== TEST ===": "",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:vrt": "playwright test --config=playwright.vr.config.ts",
    "bench": "vitest bench",
    "=== IMPORT ===": "",
    "import:assets:images:svg": "yarn workspace @infomaniak-design-system/svg-assets import",
    "=== MISC ===": "",
    "generate": "yarn workspace @infomaniak-design-system/components run generate",
    "create:figma:webhook": "node --no-warnings=ExperimentalWarning scripts/scripts/create-figma-webhook/create-figma-webhook.script.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "=== CI ===": "",
    "ci:publish": "node --no-warnings=ExperimentalWarning scripts/ci/publish/ci-publish.script.ts",
    "ci:pr-ready-for-review": "node --no-warnings=ExperimentalWarning scripts/ci/pr-ready-for-review/pr-ready-for-review.script.ts",
    "ci:storybook-pr": "node --no-warnings=ExperimentalWarning scripts/ci/storybook-pr/storybook-pr.script.ts",
    "ci:storybook-pages": "node --no-warnings=ExperimentalWarning scripts/ci/storybook-pages/storybook-pages.script.ts",
    "ci:visual-regression": "node --no-warnings=ExperimentalWarning scripts/ci/visual-regression/visual-regression.script.ts",
    "ci:figma-event": "node --no-warnings=ExperimentalWarning scripts/ci/on-figma-event/on-figma-event.script.ts",
    "ci:fix-figma-webhook": "node --no-warnings=ExperimentalWarning scripts/ci/on-figma-event/fix/fix-figma-webhook.script.ts",
    "prepare": "husky"
  },
  "description": "Infomaniak's Design System",
  "keywords": [],
  "author": "Infomaniak",
  "license": "GPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infomaniak/design-system.git"
  },
  "workspaces": {
    "packages": [
      "packages/tokens",
      "packages/tokens/demo",
      "packages/components",
      "packages/assets/images/svg",
      "packages/assets/fonts",
      "apps/docs"
    ]
  },
  "lint-staged": {
    "./**/*.{js,jsx,ts,tsx,html,css,scss,json,md,mdx}": [
      "prettier --write --ignore-unknown --config .prettierrc"
    ],
    "./**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "./**/*.{css}": [
      "stylelint \"**/*.css\" --fix"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@lit/context": "^1.1.6",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/number-to-words": "^1.2.3",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "es-toolkit": "^1.51.0",
    "eslint": "^10.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.9",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "lit": "^3.3.3",
    "number-to-words": "^1.2.4",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.4",
    "semver": "^7.8.5",
    "storybook": "^10.5.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0"
}
