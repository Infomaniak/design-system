{
  "name": "@infomaniak-design-system/esds-icon",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/public-api.d.ts",
        "default": "./dist/esds-icon.js"
      },
      "require": {
        "types": "./dist/public-api.d.ts",
        "default": "./dist/esds-icon.umd.cjs"
      }
    }
  },
  "main": "./dist/esds-icon.umd.cjs",
  "module": "./dist/esds-icon.js",
  "types": "./dist/public-api.d.ts",
  "scripts": {
    "=== DEV ===": "",
    "dev": "vite",
    "=== BUILD ===": "",
    "build": "node --no-warnings=ExperimentalWarning scripts/scripts/build-svg-component/build-svg-component.script.ts",
    "build:manual": "yarn build:vite && yarn build:types",
    "build:vite": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "=== PUBLISH ===": "",
    "publish": "node --no-warnings=ExperimentalWarning scripts/scripts/publish-svg-component/publish-svg-component.script.ts"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
