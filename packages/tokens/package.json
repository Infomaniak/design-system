{
  "name": "@infomaniak-design-system/tokens",
  "version": "0.2.5",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "=== BUILD ===": "",
    "build": "yarn build:tokens && yarn copy:dist && yarn copy:markdown && yarn copy:design-md",
    "build:tokens": "node --no-warnings=ExperimentalWarning scripts/scripts/build-tokens/build-tokens.script.ts",
    "copy:dist": "DEST=demo/node_modules/@infomaniak-design-system/tokens/ && rm -rf $DEST && mkdir -p $DEST && cp -a dist/web/. $DEST",
    "copy:markdown": "cp -r dist/markdown/*.md ../../apps/docs/src/stories/assets/",
    "copy:design-md": "mkdir -p ../../apps/docs/public && cp dist/design-md/DESIGN.md ../../apps/docs/public/DESIGN.md",
    "convert-figma-tokens": "node --no-warnings=ExperimentalWarning scripts/scripts/convert-figma-tokens/convert-figma-tokens.script.ts",
    "=== PUBLISH ===": "",
    "publish": "node --no-warnings=ExperimentalWarning scripts/scripts/publish-tokens/publish-tokens.script.ts"
  },
  "description": "Infomaniak's Design System - Tokens",
  "keywords": [
    "Infomaniak",
    "Design tokens",
    "DTCG"
  ],
  "private": true,
  "devDependencies": {
    "colorjs.io": "^0.7.1",
    "zod": "^4.4.3"
  }
}
