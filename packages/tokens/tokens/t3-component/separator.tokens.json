{
  "separator": {
    "$description": "Component tokens for separators.",
    "color": {
      "$value": "{color.border.dim2}",
      "$description": "Default separator line color (strong neutral border).",
      "$extensions": {
        "scopes": ["STROKE_COLOR"]
      }
    },
    "padding": {
      "$value": "{spacing.2xs}",
      "$description": "Default padding across the separator line.",
      "$extensions": {
        "scopes": []
      }
    },
    "thickness": {
      "$value": "{border.xs.width}",
      "$description": "Default separator line thickness.",
      "$extensions": {
        "scopes": ["STROKE_FLOAT"]
      }
    }
  }
}
