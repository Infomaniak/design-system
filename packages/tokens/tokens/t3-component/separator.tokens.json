{
  "separator": {
    "$description": "Component tokens for separators.",
    "color": {
      "$value": "{color.border.dim3}",
      "$description": "Default separator line color (subtle neutral border).",
      "$extensions": {
        "scopes": ["STROKE_COLOR"]
      }
    },
    "thickness": {
      "$value": "{border.xs.width}",
      "$description": "Default separator line thickness.",
      "$extensions": {
        "scopes": ["STROKE_FLOAT"]
      }
    }
  }
}
