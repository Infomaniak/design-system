{
  "button": {
    "background": {
      "color": {
        "$root": {
          "$value": "{color.background.elevation.surface}"
        },
        "disabled": {
          "$value": "{color.background.disabled}"
        }
      }
    },
    "content": {
      "color": {
        "$root": {
          "$value": "{color.content.primary}"
        },
        "disabled": {
          "$value": "{color.content.on.disabled}"
        }
      }
    }
  }
}
