{
  "shadow": {
    "$description": "Semantic drop-shadow scale defined by offset, blur, spread, and color components.",
    "xs": {
      "$type": "shadow",
      "$description": "Extra-small shadow for subtle elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.1}",
        "blur": "{blur.1}",
        "spread": "{dimension.0}",
        "color": "{color.shadow}"
      }
    },
    "sm": {
      "$type": "shadow",
      "$description": "Small shadow for light elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.1}",
        "blur": "{blur.2}",
        "spread": "{dimension.0}",
        "color": "{color.shadow}"
      }
    },
    "md": {
      "$type": "shadow",
      "$description": "Medium shadow for default elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.2}",
        "blur": "{blur.4}",
        "spread": "{dimension.minus-1}",
        "color": "{color.shadow}"
      }
    },
    "lg": {
      "$type": "shadow",
      "$description": "Large shadow for emphasized elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.4}",
        "blur": "{blur.6}",
        "spread": "{dimension.minus-3}",
        "color": "{color.shadow}"
      }
    },
    "xl": {
      "$type": "shadow",
      "$description": "Extra-large shadow for prominent elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.10}",
        "blur": "{blur.10}",
        "spread": "{dimension.minus-6}",
        "color": "{color.shadow}"
      }
    },
    "2xl": {
      "$type": "shadow",
      "$description": "2x-large shadow for maximum elevation.",
      "$value": {
        "offsetX": "{dimension.0}",
        "offsetY": "{dimension.25}",
        "blur": "{blur.50}",
        "spread": "{dimension.minus-12}",
        "color": "{color.shadow}"
      }
    }
  }
}
