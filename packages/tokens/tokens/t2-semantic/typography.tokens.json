{
  "$type": "typography",
  "typography": {
    "$description": "Semantic typography presets bundling font family, size, weight, letter-spacing, and line-height.",
    "xs": {
      "$description": "Extra-small typography style for captions and metadata.",
      "base": {
        "$value": {
          "fontFamily": "{font.family.base}",
          "fontSize": "{text.xs.size}",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "{text.xs.letter-spacing}",
          "lineHeight": "{text.xs.line-height}"
        },
        "$description": "Extra-small base typography (regular weight)."
      },
      "emphasized": {
        "$value": {
          "fontFamily": "{font.family.base}",
          "fontSize": "{text.xs.size}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "{text.xs.letter-spacing}",
          "lineHeight": "{text.xs.line-height}"
