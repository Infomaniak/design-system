{
  "border": {
    "$description": "Semantic border width scale for element outlines and dividers.",
    "none": {
      "width": {
        "$value": "{border-width.0}",
        "$description": "No border width.",
        "$extensions": {
          "scopes": ["STROKE_FLOAT"]
        }
      }
    },
    "xs": {
      "width": {
        "$value": "{border-width.1}",
        "$description": "Extra-small border width for fine hairline borders.",
        "$extensions": {
          "scopes": ["STROKE_FLOAT"]
        }
      }
    },
    "sm": {
      "width": {
        "$value": "{border-width.2}",
        "$description": "Small border width for subtle outlines.",
        "$extensions": {
          "scopes": ["STROKE_FLOAT"]
        }
      }
    },
    "md": {
      "width": {
        "$value": "{border-width.3}",
        "$description": "Medium border width for default element outlines.",
        "$extensions": {
          "scopes": ["STROKE_FLOAT"]
        }
      }
    },
    "lg": {
      "width": {
        "$value": "{border-width.4}",
        "$description": "Large border width for emphasized outlines.",
        "$extensions": {
          "scopes": ["STROKE_FLOAT"]
        }
      }
    }
  }
}
