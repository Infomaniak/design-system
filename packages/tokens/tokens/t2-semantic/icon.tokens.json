        "$extensions": {
          "scopes": ["WIDTH_HEIGHT"]
        }
      },
      "xl": {
        "$value": "{scale.24}",
        "$extensions": {
          "scopes": ["WIDTH_HEIGHT"]
        }
      },
      "2xl": {
        "$value": "{scale.32}",
        "$extensions": {
          "scopes": ["WIDTH_HEIGHT"]
        }
      },
      "3xl": {
        "$value": "{scale.40}",
        "$extensions": {
          "scopes": ["WIDTH_HEIGHT"]
