{
  "name": "@infomaniak-design-system/components",
  "version": "0.1.2",
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js"
    }
  },
  "scripts": {
    "=== BUILD ===": "",
    "build": "node --no-warnings=ExperimentalWarning scripts/scripts/build-components/build-components.script.ts",
    "build:manual": "yarn generate:public-api && yarn build:ts:vite && yarn build:ts:definitions && yarn analyze:cem",
    "build:ts:vite": "vite build",
    "build:ts:definitions": "tsc -p tsconfig.build.json",
    "analyze:cem": "cem analyze --config ./custom-elements-manifest.config.mjs",
    "=== PUBLISH ===": "",
    "publish": "node --no-warnings=ExperimentalWarning scripts/scripts/publish-components/publish-components.script.ts",
    "=== GENERATE ===": "",
    "generate": "plop",
    "generate:public-api": "yarn generate public-api"
  },
  "description": "Infomaniak's Design System - Components",
  "keywords": [
    "Infomaniak",
    "Components"
  ],
  "private": true,
  "dependencies": {
    "@lit-labs/signals": "^0.3.0",
    "idb": "^8.0.3",
    "lit": "^3.3.3",
    "signal-polyfill": "^0.2.2",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@iconify/types": "^2.0.0",
    "@storybook/web-components-vite": "^10.5.5",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "@wc-toolkit/type-parser": "1.3.0",
    "fake-indexeddb": "^6.2.5",
    "plop": "^4.0.5",
    "storybook": "^10.5.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "customElements": "custom-elements.json"
}
