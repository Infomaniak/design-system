import { describe, expect, it } from 'vitest';
import { {{componentClass name}} } from './{{name}}.component.ts';

{{componentClass name}}.define();

describe('{{componentClass name}}', () => {
  it('should be constructible and registered', () => {
    const el = document.createElement('{{name}}');
    expect(el).instanceOf({{componentClass name}});
  });

  it('should display the label when no slot content is provided', async () => {
    const el = document.createElement('{{name}}');
    el.label = 'Hello';
    document.body.append(el);
    await el.updateComplete;

    expect(el.shadowRoot?.textContent).toContain('Hello');

    el.remove();
  });
});
