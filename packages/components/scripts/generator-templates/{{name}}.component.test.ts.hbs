import { describe, expect, it } from 'vitest';
import { {{pascalCase name}} } from './{{name}}.component.ts';

describe('{{pascalCase name}}', () => {
  it('should be constructible and registered', () => {
    const el = document.createElement('{{name}}');
    expect(el).toBeInstanceOf({{pascalCase name}});
  });

  it('should render label', async () => {
    const el = document.createElement('{{name}}') as {{pascalCase name}};
    el.label = 'Test label';
    document.body.append(el);
    await el.updateComplete;
    expect(el.shadowRoot?.textContent).toContain('Test label');
    el.remove();
  });
});
