# GITHUB
# Required by @changesets/changelog-github to fetch PR/commit metadata for changelogs.
# Easiest: `export GITHUB_TOKEN=$(gh auth token)` before `yarn changeset:version`.
# Or create a classic PAT at https://github.com/settings/tokens/new (scope: repo for private repos).
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_PULL_REQUEST_DETAILS='{
  "html_url": "https://github.com/Infomaniak/design-system/pull/9",
  "title": "DEBUG PR title",
  "body": "DEBUG PR description",
  "user": {
    "login": "DEBUG username"
  }
}'
GITHUB_CI_CONFIG='{
  "server_url": "https://github.com",
  "repository": "Infomaniak/design-system",
  "run_id": "1234",
  "event_name": "pull_request",
  "base_ref": "main",
  "event": {
    "pull_request": {
      "base": {
        "sha": "dad6fc5e22840ad08209ce653d61798b7ac413b7"
      },
      "head": {
        "sha": "f551db1be7a0d841f297a9378bc8bd646615ebd0"
      },
      "labels": [
        {
          "name": "dev"
        }
      ]
    }
  }
}'

#CI
# uncomment to run in "dry" mode
#CI_PUBLISH_DRY_RUN="true"
CI_PULL_REQUEST_AUTH_TOKEN_MOBILE="github_pat_xxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CI_DS_UPDATE_AND_PR_AUTH_TOKEN="github_pat_xxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CI_WORKFLOW_TRIGGER_DESIGN_SYSTEM_TOKEN="github_pat_xxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# MISC
SHOULD_NOTIFY="false"

# Iconify API - uses preprod (https://iconify.preprod.dev.infomaniak.ch/) in dev otherwise production (https://iconify.infomaniak.com/)
VITE_ICONIFY_API_URL="https://iconify.preprod.dev.infomaniak.ch/"
